APP_NAME=A股回测系统
APP_VERSION=1.0.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

# 登录密码。生产环境必须设置为强密码。
QUANT_AUTH_PASSWORD=change-me

# Tushare Pro token。如使用外部 tushare_api.py 脚本注入 token，可留空。
TUSHARE_TOKEN=

# Pydantic Settings 按 JSON 解析 list 类型
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

DB_PATH=app/data
LOG_LEVEL=INFO
